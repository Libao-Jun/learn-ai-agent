---
export interface Props {
  title: string;
  date: Date;
  slug: string;
  description?: string;
  tags?: string[];
  readingTime?: number;
}

const { title, date, slug, description, tags = [], readingTime } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article class="card">
  <a href={`${base}/blog/${slug}`} class="card-link">
    <div class="card-top">
      <h2 class="card-title">{title}</h2>
      <span class="card-arrow" aria-hidden="true">&rarr;</span>
    </div>
    {description && <p class="card-desc">{description}</p>}
    {tags.length > 0 && (
      <div class="card-tags">
        {tags.slice(0, 3).map((tag) => (
          <span class="card-tag">#{tag}</span>
        ))}
        {tags.length > 3 && <span class="card-tag card-tag-more">+{tags.length - 3}</span>}
      </div>
    )}
    <div class="card-meta">
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {readingTime && <span class="card-reading-time">约 {readingTime} 分钟</span>}
    </div>
  </a>
</article>

<style>
  .card {
    position: relative;
    border-radius: var(--radius);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: all 0.3s var(--ease-smooth);
    box-shadow: var(--shadow-sm);
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-border-strong);
  }

  .card-link {
    display: block;
    padding: 1.5rem 1.75rem;
    color: inherit;
    background: none;
  }

  .card-link:hover {
    background: none;
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.35;
    color: var(--color-text);
    transition: color 0.2s;
  }

  .card-desc {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0.5rem 0 0;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-arrow {
    font-size: 1.1rem;
    color: var(--color-text-dim);
    opacity: 0;
    transform: translateX(-6px);
    transition: all 0.3s var(--ease-out);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-accent);
  }

  .card time {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-dim);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .card-meta time {
    margin-top: 0;
  }

  .card-reading-time {
    font-size: 0.78rem;
    color: var(--color-text-dim);
    font-family: var(--font-display);
  }

  .card-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .card-tag {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 100px;
    font-size: 0.68rem;
    font-weight: 600;
    font-family: var(--font-display);
  }

  .card-tag-more {
    background: var(--color-bg-alt);
    color: var(--color-text-dim);
  }
</style>