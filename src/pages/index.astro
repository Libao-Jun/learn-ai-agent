---
import { getCollection } from 'astro:content';
import { SITE } from '../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getReadingTime } from '../utils/reading-time';

const posts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latestPost = posts[0];
const restPosts = posts.slice(1);
---

<BaseLayout pageTitle={SITE.title} description={SITE.description}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-badge">{SITE.heroBadge}</div>
    <h1 class="hero-title">
      <span class="gradient-text">{SITE.title}</span>
    </h1>
    <p class="hero-subtitle">
      从零开始，记录 AI 生态学习过程中的每一个脚印。<br />
      持续精进，分享成长。
    </p>
    <div class="hero-actions">
      <a href={`${base}/blog`} class="btn-primary">阅读文章</a>
      <a href={`${base}/about`} class="btn-ghost">了解更多</a>
    </div>
    <div class="hero-keywords">
      <span>MCP</span>
      <span class="kw-sep">·</span>
      <span>Claude Code</span>
      <span class="kw-sep">·</span>
      <span>Agent</span>
      <span class="kw-sep">·</span>
      <span>Skills</span>
      <span class="kw-sep">·</span>
      <span>LLM</span>
      <span class="kw-sep">·</span>
      <span>SDD</span>
    </div>
    <!-- Floating particles (multicolor neon) -->
    <div class="hero-particles" aria-hidden="true">
      <span class="particle particle-blue" style="top:8%;left:62%;animation-delay:0s"></span>
      <span class="particle particle-cyan" style="top:25%;left:78%;animation-delay:1.2s"></span>
      <span class="particle particle-purple" style="top:45%;left:70%;animation-delay:2.4s"></span>
      <span class="particle particle-blue" style="top:65%;left:58%;animation-delay:0.6s"></span>
      <span class="particle particle-cyan" style="top:15%;left:48%;animation-delay:1.8s"></span>
      <span class="particle particle-purple" style="top:55%;left:85%;animation-delay:3s"></span>
      <span class="particle particle-cyan" style="top:75%;left:42%;animation-delay:0.3s"></span>
      <span class="particle particle-blue" style="top:35%;left:40%;animation-delay:2.1s"></span>
    </div>
    <!-- Decorative circuit grid -->
    <div class="hero-grid" aria-hidden="true"></div>
    <!-- HUD corner decorations -->
    <div class="hud-corners" aria-hidden="true">
      <span class="hud-corner hud-tl"></span>
      <span class="hud-corner hud-tr"></span>
      <span class="hud-corner hud-bl"></span>
      <span class="hud-corner hud-br"></span>
    </div>
  </section>

  <!-- Featured post -->
  {latestPost && (
    <section class="featured animate-in">
      <div class="section-label">
        <span class="label-dot"></span>
        最新文章
      </div>
      <a href={`${base}/blog/${latestPost.id}`} class="featured-card">
        <div class="featured-content">
          <div class="featured-tags">
            {latestPost.data.tags.map((tag) => (
              <span class="tag-sm">#{tag}</span>
            ))}
          </div>
          <h2 class="featured-title">{latestPost.data.title}</h2>
          {latestPost.data.description && (
            <p class="featured-desc">{latestPost.data.description}</p>
          )}
          <time datetime={latestPost.data.date.toISOString()}>
            {latestPost.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
        <div class="featured-arrow">&rarr;</div>
      </a>
    </section>
  )}

  <!-- All posts -->
  <section class="posts-section">
    <div class="section-head">
      <div class="section-label">
        <span class="label-dot"></span>
        全部文章
      </div>
      <a href={`${base}/blog`} class="section-link">查看全部 &rarr;</a>
    </div>

    {restPosts.length === 0 ? (
      <div class="empty-state">
        <p>更多文章正在路上...</p>
      </div>
    ) : (
      <div class="card-grid stagger">
        {restPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            date={post.data.date}
            slug={post.id}
            description={post.data.description}
            tags={post.data.tags}
            readingTime={getReadingTime(post.body || '')}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    padding: 6rem 0 4rem;
    overflow: hidden;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.3rem 1rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border: 1px solid var(--color-border-accent);
    border-radius: 100px;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.5s var(--ease-out) both, borderBreath 4s ease-in-out 0.5s infinite;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    margin: 0 0 1.25rem;
    letter-spacing: -0.04em;
    line-height: 1.15;
    animation: fadeInUp 0.6s var(--ease-out) 0.1s both;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-glow) 40%, var(--color-accent-secondary) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 200% 200%;
    animation: gradientShift 6s ease-in-out infinite;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin: 0 0 2rem;
    max-width: 480px;
    animation: fadeInUp 0.6s var(--ease-out) 0.2s both;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    animation: fadeInUp 0.6s var(--ease-out) 0.3s both;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.5rem;
    background: var(--color-accent);
    color: var(--color-btn-on-accent);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.25s var(--ease-smooth);
    box-shadow: 0 0 20px var(--glow-btn);
  }

  .btn-primary:hover {
    background: var(--color-accent-glow);
    box-shadow: 0 0 30px var(--glow-btn-hover);
    transform: translateY(-1px);
    color: var(--color-btn-on-accent);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.5rem;
    background: transparent;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.25s var(--ease-smooth);
  }

  .btn-ghost:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
    background: var(--color-surface);
  }

  /* ── Hero Particles ── */
  .hero-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    opacity: 0;
    animation: particleFloat 5s ease-in-out infinite;
  }
  .particle-blue {
    background: var(--color-accent);
    box-shadow: 0 0 6px var(--glow-dot), 0 0 12px var(--glow-btn);
  }
  .particle-cyan {
    background: var(--color-neon-cyan);
    box-shadow: 0 0 6px var(--glow-cyan-strong), 0 0 12px var(--glow-cyan);
  }
  .particle-purple {
    background: var(--color-neon-magenta);
    box-shadow: 0 0 6px var(--glow-magenta-strong), 0 0 12px var(--glow-magenta);
  }

  @keyframes particleFloat {
    0%, 100% { opacity: 0; transform: translateY(0) scale(1); }
    20% { opacity: 0.8; }
    50% { opacity: 0.4; transform: translateY(-25px) scale(1.3); }
    80% { opacity: 0.15; }
  }

  /* ── Hero Keywords ── */
  .hero-keywords {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-dim);
    animation: fadeInUp 0.6s var(--ease-out) 0.35s both;
  }

  .kw-sep {
    color: var(--color-border-strong);
  }

  /* ── Circuit Grid ── */
  .hero-grid {
    position: absolute;
    top: 5%;
    right: -5%;
    width: 350px;
    height: 350px;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 35px 35px;
    opacity: 0.3;
    mask-image: radial-gradient(circle at 40% 40%, black 25%, transparent 70%);
    -webkit-mask-image: radial-gradient(circle at 40% 40%, black 25%, transparent 70%);
    animation: float 10s ease-in-out infinite;
  }

  /* ── HUD Corners ── */
  .hud-corners {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }
  .hud-corner {
    position: absolute;
    width: 40px;
    height: 40px;
    animation: hudCornerPulse 3s ease-in-out infinite;
  }
  .hud-corner::before,
  .hud-corner::after {
    content: '';
    position: absolute;
    background: var(--color-accent);
    box-shadow: 0 0 6px var(--glow-dot), 0 0 14px var(--glow-btn);
  }
  .hud-corner::before { width: 100%; height: 1.5px; }
  .hud-corner::after  { width: 1.5px; height: 100%; }

  .hud-tl { top: 0; left: 0; animation-delay: 0s; }
  .hud-tl::before { top: 0; left: 0; }
  .hud-tl::after  { top: 0; left: 0; }

  .hud-tr { top: 0; right: 0; animation-delay: 0.8s; }
  .hud-tr::before { top: 0; right: 0; }
  .hud-tr::after  { top: 0; right: 0; }

  .hud-bl { bottom: 0; left: 0; animation-delay: 1.6s; }
  .hud-bl::before { bottom: 0; left: 0; }
  .hud-bl::after  { bottom: 0; left: 0; }

  .hud-br { bottom: 0; right: 0; animation-delay: 2.4s; }
  .hud-br::before,
  .hud-br::after {
    background: var(--color-neon-magenta);
    box-shadow: 0 0 6px var(--glow-magenta-strong), 0 0 14px var(--glow-magenta);
  }

  @media (max-width: 768px) {
    .hud-corners { display: none; }
  }

  /* ── Section Label ── */
  .section-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .label-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--glow-dot);
  }

  /* ── Featured ── */
  .featured {
    margin-bottom: 3rem;
  }

  .featured-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 2.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all 0.3s var(--ease-smooth);
    gap: 1.5rem;
  }

  .featured-card:hover {
    border-color: var(--color-border-accent);
    box-shadow: var(--shadow-glow);
    transform: translateY(-2px);
    background: var(--color-surface-hover);
  }

  .featured-content {
    flex: 1;
  }

  .featured-tags {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .tag-sm {
    padding: 0.15rem 0.55rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 600;
    font-family: var(--font-display);
  }

  .featured-title {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
    transition: color 0.2s;
  }

  .featured-card:hover .featured-title {
    color: var(--color-accent);
  }

  .featured-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0 0 0.75rem;
    line-height: 1.6;
  }

  .featured-arrow {
    font-size: 1.5rem;
    color: var(--color-text-dim);
    transition: all 0.3s var(--ease-smooth);
    flex-shrink: 0;
  }

  .featured-card:hover .featured-arrow {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  /* ── Posts Section ── */
  .posts-section {
    margin-top: 1rem;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .section-link {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background: none;
    transition: color 0.2s;
  }

  .section-link:hover {
    color: var(--color-accent);
  }

  .card-grid {
    display: grid;
    gap: 1rem;
  }

  .empty-state {
    padding: 3rem 0;
    text-align: center;
    color: var(--color-text-muted);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero {
      padding: 4rem 0 3rem;
    }

    .hero-title {
      font-size: 2.4rem;
    }

    .hero-grid {
      display: none;
    }

    .featured-card {
      padding: 1.5rem;
      flex-direction: column;
      align-items: flex-start;
    }

    .featured-arrow {
      align-self: flex-end;
    }
  }
</style>