---
import { getCollection } from 'astro:content';
import { SITE } from '../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getReadingTime } from '../utils/reading-time';

const posts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latestPost = posts[0];
const restPosts = posts.slice(1);
---

<BaseLayout pageTitle={SITE.title} description={SITE.description}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-orb hero-orb--1" aria-hidden="true"></div>
    <div class="hero-orb hero-orb--2" aria-hidden="true"></div>
    <div class="hero-badge"><span class="badge-text">{SITE.heroBadge}</span><span class="badge-cursor" aria-hidden="true">|</span></div>
    <h1 class="hero-title">{SITE.title}</h1>
    <p class="hero-subtitle">
      从零开始，记录 AI 生态学习过程中的每一个脚印。<br />
      持续精进，分享成长。
    </p>
    <div class="hero-actions">
      <a href={`${base}/blog`} class="btn-primary">阅读文章</a>
      <a href={`${base}/about`} class="btn-ghost">了解更多</a>
    </div>
    <div class="hero-keywords">
      <span>MCP</span>
      <span class="kw-sep">·</span>
      <span>Claude Code</span>
      <span class="kw-sep">·</span>
      <span>Agent</span>
      <span class="kw-sep">·</span>
      <span>Skills</span>
      <span class="kw-sep">·</span>
      <span>LLM</span>
      <span class="kw-sep">·</span>
      <span>SDD</span>
    </div>
    <div class="hero-ribbon"></div>
  </section>

  <!-- Featured post -->
  {latestPost && (
    <section class="featured reveal-on-scroll">
      <div class="section-label">
        <span class="label-dot"></span>
        最新文章
      </div>
      <a href={`${base}/blog/${latestPost.id}`} class="featured-card">
        <div class="featured-content">
          <div class="featured-tags">
            {latestPost.data.tags.map((tag) => (
              <span class="tag-sm">#{tag}</span>
            ))}
          </div>
          <h2 class="featured-title">{latestPost.data.title}</h2>
          {latestPost.data.description && (
            <p class="featured-desc">{latestPost.data.description}</p>
          )}
          <time datetime={latestPost.data.date.toISOString()}>
            {latestPost.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
        <div class="featured-arrow">&rarr;</div>
      </a>
    </section>
  )}

  <!-- All posts -->
  <section class="posts-section">
    <div class="section-head">
      <div class="section-label">
        <span class="label-dot"></span>
        全部文章
      </div>
      <a href={`${base}/blog`} class="section-link">查看全部 &rarr;</a>
    </div>

    {restPosts.length === 0 ? (
      <div class="empty-state">
        <p>更多文章正在路上...</p>
      </div>
    ) : (
      <div class="card-grid reveal-grid">
        {restPosts.map((post, i) => (
          <BlogCard
            title={post.data.title}
            date={post.data.date}
            slug={post.id}
            description={post.data.description}
            tags={post.data.tags}
            readingTime={getReadingTime(post.body || '')}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    padding: 6rem 0 5rem;
    overflow: hidden;
  }

  /* ── Hero Background Orbs ── */
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-orb--1 {
    width: 560px;
    height: 560px;
    top: -240px;
    right: -180px;
    background: radial-gradient(circle, rgba(0, 102, 204, 0.10) 0%, transparent 70%);
    animation: float 12s ease-in-out infinite;
  }

  .hero-orb--2 {
    width: 420px;
    height: 420px;
    bottom: -180px;
    left: -120px;
    background: radial-gradient(circle, rgba(41, 151, 255, 0.07) 0%, transparent 70%);
    animation: floatSlow 16s ease-in-out infinite;
  }

  .hero-badge {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0;
    padding: 0.25rem 0.85rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border: 1px solid var(--color-accent-border-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.5s var(--ease-out) both;
  }

  .badge-cursor {
    margin-left: 2px;
    font-weight: 400;
    animation: blink 1s step-end infinite;
  }

  .hero-title {
    position: relative;
    z-index: 1;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 600;
    margin: 0 0 1.25rem;
    letter-spacing: -0.005em;
    line-height: 1.07;
    animation: fadeInUp 0.6s var(--ease-out) 0.1s both;
  }

  .hero-subtitle {
    position: relative;
    z-index: 1;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin: 0 0 2rem;
    max-width: 480px;
    animation: fadeInUp 0.6s var(--ease-out) 0.2s both;
  }

  .hero-actions {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 0.75rem;
    animation: fadeInUp 0.6s var(--ease-out) 0.3s both;
  }

  /* ── Hero Keywords ── */
  .hero-keywords {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-text-dim);
    letter-spacing: -0.014em;
    animation: fadeInUp 0.6s var(--ease-out) 0.35s both;
  }

  .kw-sep {
    color: var(--color-border-strong);
    font-weight: 300;
  }

  /* ── Hero Ribbon ── */
  .hero-ribbon {
    animation: ribbonDrift 4s ease-in-out infinite;
  }

  /* ── Section Label ── */
  .section-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 1.25rem;
  }

  .label-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulseDot 2.5s ease-in-out infinite;
  }

  /* ── Featured ── */
  .featured {
    margin-bottom: 3rem;
  }

  .featured-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 2.5rem;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border-accent);
    border-radius: var(--radius-lg);
    transition: all 0.3s var(--ease-smooth);
    gap: 1.5rem;
    overflow: hidden;
  }

  /* Animated border sweep on hover */
  .featured-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    padding: 1px;
    background: linear-gradient(
      135deg,
      transparent 30%,
      var(--color-accent) 50%,
      var(--color-accent-on-dark) 70%,
      transparent
    );
    background-size: 300% 300%;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s var(--ease-smooth);
    pointer-events: none;
    animation: shimmer 4s ease infinite;
  }

  .featured-card:hover::before {
    opacity: 1;
  }

  .featured-card:hover {
    background: var(--color-surface-hover);
    transform: translateY(-2px);
    box-shadow: 0 0 30px 4px rgba(0, 102, 204, 0.08);
  }

  .featured-content {
    flex: 1;
  }

  .featured-tags {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .tag-sm {
    padding: 0.15rem 0.5rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border: 1px solid var(--color-accent-border-subtle);
    border-radius: var(--radius-sm);
    font-size: 0.68rem;
    font-weight: 600;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .featured-title {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
    transition: color 0.2s;
  }

  .featured-card:hover .featured-title {
    color: var(--color-accent);
  }

  .featured-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0 0 0.75rem;
    line-height: 1.6;
  }

  .featured-arrow {
    font-size: 1.5rem;
    color: var(--color-text-dim);
    transition: all 0.3s var(--ease-smooth);
    flex-shrink: 0;
  }

  .featured-card:hover .featured-arrow {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  /* ── Posts Section ── */
  .posts-section {
    margin-top: 1rem;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .section-link {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: none;
    transition: color 0.2s;
  }

  .section-link:hover {
    color: var(--color-accent);
  }

  .card-grid {
    display: grid;
    gap: 1rem;
  }

  .empty-state {
    padding: 3rem 0;
    text-align: center;
    color: var(--color-text-muted);
  }

  /* ── Responsive ── */

  /* Tablet (≤768px) */
  @media (max-width: 768px) {
    .hero {
      padding: 4rem 0 3rem;
    }

    .hero-title {
      font-size: 2.4rem;
    }

    .hero-subtitle {
      font-size: 1rem;
      max-width: 400px;
    }

    .hero-keywords {
      font-size: 0.8rem;
      gap: 0.4rem;
    }

    .featured-card {
      padding: 1.5rem;
      flex-direction: column;
      align-items: flex-start;
    }

    .featured-title {
      font-size: 1.3rem;
    }

    .featured-arrow {
      align-self: flex-end;
    }
  }

  /* Large phone (≤480px) */
  @media (max-width: 480px) {
    .hero {
      padding: 3rem 0 2.5rem;
    }

    .hero-title {
      font-size: 1.85rem;
    }

    .hero-subtitle {
      font-size: 0.92rem;
      line-height: 1.7;
    }

    .hero-actions {
      flex-direction: column;
      gap: 0.5rem;
    }

    .hero-keywords {
      font-size: 0.72rem;
      gap: 0.3rem;
      margin-top: 1rem;
    }

    .hero-badge {
      font-size: 0.65rem;
      padding: 0.2rem 0.7rem;
    }

    .featured-card {
      padding: 1.25rem;
    }

    .featured-title {
      font-size: 1.15rem;
    }

    .featured-desc {
      font-size: 0.85rem;
    }

    .section-label {
      font-size: 0.65rem;
    }
  }

  /* Desktop: multi-column card grid */
  @media (min-width: 769px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1025px) {
    .card-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  // Scroll-triggered reveal for cards & sections
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        // Stagger each card within the visible set
        const delay = Array.from(entry.target.parentElement?.children || [])
          .filter(c => c.classList.contains('reveal-on-scroll') && !c.classList.contains('revealed'))
          .indexOf(entry.target);
        setTimeout(() => {
          entry.target.classList.add('revealed');
        }, Math.min(delay, 5) * 80);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });

  // Observe featured section
  document.querySelectorAll('.featured.reveal-on-scroll').forEach(el => observer.observe(el));

  // Observe card grid children
  const grid = document.querySelector('.reveal-grid');
  if (grid) {
    grid.querySelectorAll(':scope > *').forEach(card => {
      card.classList.add('reveal-on-scroll');
      observer.observe(card);
    });
  }
</script>