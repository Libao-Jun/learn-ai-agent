---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog');
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const tagCounts = new Map<string, number>();
posts.forEach((post) => {
  post.data.tags.forEach((tag: string) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});
const sortedTags = allTags.sort((a, b) => (tagCounts.get(b) || 0) - (tagCounts.get(a) || 0));
---

<BaseLayout pageTitle="标签" description="按标签浏览文章">
  <section class="tags-page animate-in">
    <header class="page-header">
      <div class="section-label">
        <span class="label-dot"></span>
        标签
      </div>
      <h1 class="page-title">标签</h1>
      <p class="page-count">{allTags.length} 个标签</p>
    </header>

    {allTags.length === 0 ? (
      <div class="empty-state">
        <p>还没有标签。</p>
      </div>
    ) : (
      <div class="tag-cloud stagger">
        {sortedTags.map((tag) => (
          <a href={`${base}/tags/${tag}`} class="tag-card">
            <span class="tag-hash">#</span>
            <span class="tag-name">{tag}</span>
            <span class="tag-count">{tagCounts.get(tag)}</span>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .tags-page {
    margin-top: 2rem;
  }

  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }

  .label-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
  }

  .page-count {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /*
    ── Tag Pill: cssbuttons-io gradient style ──
    Ref: uiverse.io/cssbuttons-io/wonderful-baboon-62
    Signature: vibrant gradient bg, no border, glow shadow, white text, scale on hover
  */
  .tag-card {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.2rem;
    text-decoration: none;
    cursor: pointer;

    /* ── The gradient — Action Blue spectrum ── */
    background: linear-gradient(
      144deg,
      #0066cc,
      #2997ff 50%,
      #00a8ff
    );

    /* No border — gradient defines the visual edge */
    border: none;
    border-radius: var(--radius-pill);

    /* Soft glow beneath */
    box-shadow:
      rgba(0, 102, 204, 0.25) 0 8px 24px -6px;

    /* Smooth everything */
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s var(--ease-smooth);
  }

  /* ── Hover: pop + stronger glow ── */
  .tag-card:hover {
    transform: scale(1.06);
    box-shadow:
      rgba(0, 102, 204, 0.35) 0 15px 35px -4px,
      rgba(0, 168, 255, 0.15) 0 8px 20px -4px;
  }

  /* ── Hash symbol — semi-transparent white ── */
  .tag-hash {
    color: rgba(255, 255, 255, 0.65);
    font-weight: 700;
    font-size: 0.88rem;
    line-height: 1;
    transition: color 0.3s var(--ease-smooth);
    margin-right: -0.02rem;
  }

  .tag-card:hover .tag-hash {
    color: rgba(255, 255, 255, 0.95);
  }

  /* ── Tag name — crisp white on gradient ── */
  .tag-name {
    font-family: var(--font-body);
    font-weight: 600;
    color: #ffffff;
    font-size: 0.88rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* ── Count badge — translucent white chip on gradient ── */
  .tag-count {
    font-size: 0.7rem;
    font-weight: 600;
    font-family: var(--font-body);
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.18);
    padding: 0.12rem 0.5rem;
    border-radius: 100px;
    line-height: 1.35;
    margin-left: 0.15rem;
    transition:
      color 0.3s var(--ease-smooth),
      background 0.3s var(--ease-smooth);
  }

  .tag-card:hover .tag-count {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.3);
  }

  .empty-state {
    padding: 4rem 0;
    text-align: center;
    color: var(--color-text-muted);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .tags-page {
      margin-top: 1.5rem;
    }

    .page-title {
      font-size: 1.65rem;
    }

    .page-count {
      font-size: 0.82rem;
    }

    .tag-cloud {
      gap: 0.6rem;
    }

    .tag-card {
      padding: 0.48rem 1rem;
    }

    .tag-card:hover {
      transform: scale(1.04);
    }

    .tag-name {
      font-size: 0.82rem;
    }

    .tag-hash {
      font-size: 0.82rem;
    }

    .tag-count {
      font-size: 0.66rem;
      padding: 0.1rem 0.45rem;
    }
  }

  @media (max-width: 480px) {
    .tags-page {
      margin-top: 1rem;
    }

    .page-header {
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
    }

    .page-title {
      font-size: 1.4rem;
    }

    .tag-cloud {
      gap: 0.5rem;
    }

    .tag-card {
      padding: 0.42rem 0.85rem;
    }

    .tag-card:hover {
      transform: scale(1.04);
      box-shadow:
        rgba(0, 102, 204, 0.3) 0 10px 25px -4px;
    }

    .tag-name {
      font-size: 0.78rem;
    }

    .tag-hash {
      font-size: 0.78rem;
    }

    .tag-count {
      font-size: 0.64rem;
      padding: 0.08rem 0.4rem;
    }
  }</style>