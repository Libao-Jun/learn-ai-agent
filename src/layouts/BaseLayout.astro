---
import '../styles/global.css';
import { SITE } from '../site.config';
import ThemeToggle from '../components/ThemeToggle.astro';
import Mermaid from '../components/Mermaid.astro';

export interface Props {
  pageTitle: string;
  description?: string;
}

const { pageTitle, description } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description || pageTitle} />
  <title>{pageTitle} — {SITE.title}</title>
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <script is:inline>
    (function() {
      var stored = localStorage.getItem('theme');
      if (stored) {
        document.documentElement.setAttribute('data-theme', stored);
      } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
</head>
<body>
  <div class="reading-progress" id="progress-bar"></div>

  <header class="nav-bar">
    <div class="nav-inner">
      <a href={base || '/'} class="logo">
        <span class="logo-icon">&#x25C8;</span>
        <span class="logo-text">LAI</span>
      </a>
      <div class="nav-right">
        <nav>
          <a href={`${base}/`} class:list={["nav-link", { active: currentPath === `${base}/` || currentPath === '/' }]}>首页</a>
          <a href={`${base}/blog`} class:list={["nav-link", { active: currentPath.startsWith(`${base}/blog`) }]}>文章</a>
          <a href={`${base}/tags`} class:list={["nav-link", { active: currentPath.startsWith(`${base}/tags`) }]}>标签</a>
          <a href={`${base}/about`} class:list={["nav-link", { active: currentPath === `${base}/about` || currentPath === `${base}/about/` }]}>关于</a>
        </nav>
        <ThemeToggle />
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-grid">
        <div class="footer-col footer-brand-col">
          <div class="footer-brand">
            <span class="logo-icon small">&#x25C8;</span>
            <span>{SITE.title}</span>
          </div>
          <p class="footer-tagline">{SITE.tagline}</p>
        </div>
        <div class="footer-col">
          <span class="footer-heading">导航</span>
          <a href={`${base}/`}>首页</a>
          <a href={`${base}/blog`}>文章</a>
          <a href={`${base}/tags`}>标签</a>
          <a href={`${base}/about`}>关于</a>
        </div>
        <div class="footer-col">
          <span class="footer-heading">订阅</span>
          <a href={`${base}rss.xml`}>RSS 订阅</a>
          <a href="https://github.com/libao-jun/learn-ai-agent" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
      <p class="footer-copy">&copy; {new Date().getFullYear()} {SITE.author} &mdash; Built with <a href="https://astro.build">Astro</a></p>
    </div>
  </footer>

  <!-- Back to top -->
  <button class="back-to-top" id="back-to-top" aria-label="回到顶部" title="回到顶部">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"/>
    </svg>
  </button>

  <Mermaid />
</body>
</html>

<script>
  const bar = document.getElementById('progress-bar');
  const backToTop = document.getElementById('back-to-top');
  if (bar || backToTop) {
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      if (bar) {
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        bar.style.width = `${Math.min(progress, 100)}%`;
      }
      if (backToTop) {
        backToTop.classList.toggle('visible', scrollTop > 400);
      }
    }, { passive: true });
  }
  if (backToTop) {
    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<style>
  /* ── Navigation ── */
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 1000;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    padding: 0 2rem;
    background: var(--color-nav-backdrop);
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.35s var(--ease-smooth), border-color 0.35s var(--ease-smooth);
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--max-width-wide);
    width: 100%;
    margin: 0 auto;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-text);
    background: none;
    padding-bottom: 0;
    transition: color 0.2s;
  }

  .logo:hover {
    color: var(--color-accent);
    background: none;
  }

  .logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-logo-icon-text);
    font-size: 0.7rem;
  }

  .logo-icon.small {
    width: 24px;
    height: 24px;
    font-size: 0.6rem;
  }

  nav {
    display: flex;
    gap: 0.15rem;
  }

  .nav-link {
    padding: 0.4rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 400;
    font-family: var(--font-body);
    color: var(--color-text-muted);
    background: none;
    letter-spacing: -0.01em;
    transition: all 0.2s var(--ease-smooth);
    position: relative;
  }

  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .nav-link.active {
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .nav-link.active:hover {
    color: var(--color-accent);
  }

  /* ── Main ── */
  main {
    position: relative;
    z-index: 1;
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 0 2rem;
    min-height: calc(100vh - 200px);
  }

  /* ── Footer ── */
  .site-footer {
    position: relative;
    z-index: 1;
    margin-top: 6rem;
    padding: 3rem 2rem 1.5rem;
    background: var(--color-bg-alt);
    transition: background-color 0.35s var(--ease-smooth), border-color 0.35s var(--ease-smooth);
  }

  .footer-inner {
    max-width: var(--max-width-wide);
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer-heading {
    display: block;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-dim);
    margin-bottom: 0.75rem;
  }

  .footer-col a {
    display: block;
    padding: 0.2rem 0;
    font-size: 1.0625rem;
    line-height: 2.41;
    color: var(--color-text-muted);
    background: none;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--color-accent);
  }

  .footer-brand-col .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .footer-tagline {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    margin: 0;
  }

  .footer-copy {
    color: var(--color-text-dim);
    font-size: 0.78rem;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .footer-copy a {
    color: var(--color-text-muted);
    background: none;
  }

  .footer-copy a:hover {
    color: var(--color-accent);
  }

  /* ── Back to Top ── */
  .back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 999;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    cursor: pointer;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: all 0.3s var(--ease-out);
    padding: 0;
    box-shadow: var(--shadow-md);
  }

  .back-to-top.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .back-to-top:hover {
    background: var(--color-accent);
    color: var(--color-btn-on-accent);
    border-color: var(--color-accent);
  }

  /* ── Responsive ── */

  /* Tablet (≤768px) */
  @media (max-width: 768px) {
    .nav-bar {
      padding: 0 1rem;
    }

    main {
      padding: 0 1rem;
    }

    .logo-text {
      display: none;
    }

    .nav-link {
      padding: 0.35rem 0.7rem;
      font-size: 0.85rem;
    }

    .site-footer {
      padding: 2.5rem 1.5rem 1.25rem;
    }
  }

  /* Large phone (≤480px) */
  @media (max-width: 480px) {
    .nav-bar {
      padding: 0 0.75rem;
    }

    main {
      padding: 0 0.85rem;
    }

    nav {
      gap: 0;
    }

    .nav-link {
      padding: 0.3rem 0.55rem;
      font-size: 0.8rem;
    }

    .site-footer {
      margin-top: 4rem;
      padding: 2rem 1rem 1rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }

    .footer-col a {
      font-size: 0.95rem;
      line-height: 2.2;
    }

    .footer-copy {
      font-size: 0.72rem;
    }

    .back-to-top {
      bottom: 1rem;
      right: 0.75rem;
      width: 38px;
      height: 38px;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .back-to-top {
      bottom: 1.25rem;
      right: 1rem;
    }
  }
</style>