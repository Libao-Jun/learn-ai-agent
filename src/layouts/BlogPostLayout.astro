---
import BaseLayout from './BaseLayout.astro';

interface Heading {
  text: string;
  slug: string;
  depth: number;
}

interface PrevNextPost {
  id: string;
  data: { title: string; description?: string };
}

export interface Props {
  title: string;
  date: Date;
  tags?: string[];
  headings?: Heading[];
  readingTime?: number;
  prevPost?: PrevNextPost | null;
  nextPost?: PrevNextPost | null;
}

const {
  title,
  date,
  tags = [],
  headings = [],
  readingTime,
  prevPost,
  nextPost,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formattedDate = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const showToc = headings.length >= 2;
---

<BaseLayout pageTitle={title}>
  <div class="article-container">
    <!-- Main content -->
    <article class="post animate-in">
      <header class="post-header">
        <a href={`${base}/blog`} class="back-link">&larr; 文章列表</a>
        <h1 class="post-title">{title}</h1>

        <div class="post-meta">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          {readingTime && <span class="post-reading-time">约 {readingTime} 分钟</span>}
          {tags.length > 0 && (
            <div class="post-tags">
              {tags.map((tag) => (
                <a href={`${base}/tags/${tag}`} class="tag-pill">#{tag}</a>
              ))}
            </div>
          )}
        </div>
      </header>

      <div class="post-body">
        <slot />
      </div>

      <footer class="post-footer">
        <!-- Prev / Next navigation -->
        <nav class="prev-next-nav">
          {prevPost ? (
            <a href={`${base}/blog/${prevPost.id}`} class="prev-next-link prev">
              <span class="prev-next-label">&larr; 上一篇</span>
              <span class="prev-next-title">{prevPost.data.title}</span>
            </a>
          ) : <div class="prev-next-spacer" />}
          {nextPost ? (
            <a href={`${base}/blog/${nextPost.id}`} class="prev-next-link next">
              <span class="prev-next-label">下一篇 &rarr;</span>
              <span class="prev-next-title">{nextPost.data.title}</span>
            </a>
          ) : <div class="prev-next-spacer" />}
        </nav>
        <nav class="post-footer-nav">
          <a href={`${base}/blog`} class="back-link">&larr; 文章列表</a>
        </nav>
      </footer>
    </article>

    <!-- Right sidebar: on-page TOC -->
    {showToc && (
      <aside class="right-sidebar">
        <nav class="toc">
          <span class="toc-label">目录</span>
          <ul class="toc-list">
            {headings.map((h) => (
              <li class:list={['toc-item', { sub: h.depth === 3, 'sub-sub': h.depth === 4 }]}>
                <a href={`#${h.slug}`} class="toc-link">{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>

<script>
  function initToc() {
    const tocList = document.querySelector('.toc-list');
    if (!tocList) return;

    const links = [...tocList.querySelectorAll('.toc-link')] as HTMLAnchorElement[];
    if (links.length === 0) return;

    const slugs = links.map((l) => l.getAttribute('href')!.replace('#', ''));

    const postHeadings = document.querySelectorAll('.post-body h2, .post-body h3, .post-body h4');
    postHeadings.forEach((h) => {
      const raw = h.textContent?.replace(/[`*_~\[\]()]/g, '').trim() || '';
      const slug = raw
        .toLowerCase()
        .replace(/[^\w一-鿿\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');
      if (slugs.includes(slug) && !h.id) {
        h.id = slug;
      }
    });

    const NAV_OFFSET = 90;
    let ticking = false;

    function updateActive() {
      let activeIndex = -1;
      const headingEls = slugs
        .map((s) => document.getElementById(s))
        .filter(Boolean) as HTMLElement[];

      for (let i = headingEls.length - 1; i >= 0; i--) {
        if (headingEls[i].getBoundingClientRect().top < NAV_OFFSET) {
          activeIndex = i;
          break;
        }
      }

      links.forEach((link, i) => {
        link.classList.toggle('active', i === activeIndex);
      });
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateActive();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    tocList.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('.toc-link');
      if (!link) return;
      e.preventDefault();
      const id = (link as HTMLAnchorElement).getAttribute('href')!.replace('#', '');
      const target = document.getElementById(id);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
        links.forEach((l) => l.classList.remove('active'));
        (link as HTMLElement).classList.add('active');
        history.replaceState(null, '', `#${id}`);
      }
    });

    updateActive();
  }

  initToc();

  // Wrap tables for responsive scrolling
  document.querySelectorAll('.post-body table').forEach((table) => {
    if (!table.parentElement?.classList.contains('table-wrapper')) {
      const wrapper = document.createElement('div');
      wrapper.className = 'table-wrapper';
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    }
  });

  // Code copy buttons
  (function initCodeCopy() {
    const pres = document.querySelectorAll('.post-body pre');
    pres.forEach((pre) => {
      if (pre.querySelector('.code-copy-btn')) return;

      const wrapper = document.createElement('div');
      wrapper.style.position = 'relative';

      const btn = document.createElement('button');
      btn.className = 'code-copy-btn';
      btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      btn.setAttribute('aria-label', '复制代码');
      btn.title = '复制代码';
      btn.addEventListener('click', async () => {
        const codeText = pre.querySelector('code')?.textContent || pre.textContent || '';
        try {
          await navigator.clipboard.writeText(codeText);
          btn.classList.add('copied');
          btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>';
          setTimeout(() => {
            btn.classList.remove('copied');
            btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
          }, 2000);
        } catch { /* clipboard API not available */ }
      });

      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(btn);
      wrapper.appendChild(pre);
    });
  })();
</script>

<style>
  /* ── Two-Column Layout ── */
  .article-container {
    display: grid;
    grid-template-columns: minmax(0, 1200px) 200px;
    gap: 3rem;
    justify-content: center;
    margin: 3rem 0;
  }

  .post {
    min-width: 0;
  }

  /* ── Post Header ── */
  .post-header {
    margin-bottom: 3rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-dim);
    background: none;
    padding: 0;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-text);
    background: none;
  }

  .post-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 2rem 0 1.25rem;
    letter-spacing: -0.04em;
    line-height: 1.15;
    color: var(--color-text);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-meta time {
    color: var(--color-text-dim);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .post-reading-time {
    color: var(--color-text-dim);
    font-size: 0.82rem;
    font-family: var(--font-display);
  }

  .post-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag-pill {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 600;
    font-family: var(--font-display);
    transition: all 0.2s ease;
    border: 1px solid var(--color-accent-border-subtle);
  }

  .tag-pill:hover {
    background: var(--color-accent-soft-hover);
    color: var(--color-accent-hover);
    border-color: var(--color-border-accent);
  }

  /* ── Post Body ── */
  .post-body {
    line-height: 1.85;
    font-size: 1rem;
    color: var(--color-text);
  }

  .post-body :global(h1) {
    font-size: 2rem;
    font-weight: 700;
    margin: 3rem 0 1rem;
    letter-spacing: -0.03em;
  }

  .post-body :global(h2) {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 2.75rem 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .post-body :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 1.75rem 0 0.5rem;
  }

  .post-body :global(p) {
    margin: 0 0 1.25rem;
  }

  .post-body :global(blockquote p) {
    margin: 0;
  }
  .post-body :global(blockquote p + p) {
    margin-top: 0.75rem;
  }

  .post-body :global(.md-callout) {
    --callout-color: var(--color-accent);
    margin: 1.75rem 0;
    padding: 1rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--callout-color) 35%, transparent);
    border-left: 3px solid var(--callout-color);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: color-mix(in srgb, var(--callout-color) 12%, transparent);
  }

  .post-body :global(.md-callout-note) {
    --callout-color: var(--color-text-muted);
  }

  .post-body :global(.md-callout-warning) {
    --callout-color: #d97706;
  }

  .post-body :global(.md-callout-danger) {
    --callout-color: #dc2626;
  }

  .post-body :global(.md-callout-title) {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--callout-color);
    font-weight: 700;
  }

  .post-body :global(.md-callout p) {
    margin: 0;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.5rem;
  }

  .post-body :global(li) {
    margin: 0.25rem 0;
  }

  .post-body :global(li)::marker {
    color: var(--color-text-dim);
  }

  .post-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .post-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    transition: color 0.2s ease;
  }

  .post-body :global(a):hover {
    color: var(--color-accent-hover);
  }

  /* ── Code Copy Button ── */
  .code-copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--color-border-strong);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    opacity: 0;
    transition: all 0.2s ease;
    padding: 0;
    z-index: 1;
  }

  .post-body :global(pre):hover .code-copy-btn,
  .code-copy-btn:focus-visible {
    opacity: 1;
  }

  .code-copy-btn:hover {
    background: var(--color-surface-hover);
    color: var(--color-accent);
    border-color: var(--color-border-accent);
  }

  .code-copy-btn.copied {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* ── Post Footer ── */
  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  /* ── Prev / Next Navigation ── */
  .prev-next-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .prev-next-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: all 0.25s var(--ease-smooth);
    background-image: none;
  }

  .prev-next-link:hover {
    border-color: var(--color-border-accent);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-1px);
  }

  .prev-next-link.next {
    text-align: right;
  }

  .prev-next-label {
    font-size: 0.72rem;
    font-weight: 600;
    font-family: var(--font-display);
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .prev-next-title {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .prev-next-link:hover .prev-next-title {
    color: var(--color-accent);
  }

  .prev-next-spacer { display: none; }

  @media (max-width: 640px) {
    .prev-next-nav {
      grid-template-columns: 1fr;
    }
    .prev-next-link.next {
      text-align: left;
    }
  }

  /* ── Right Sidebar TOC ── */
  .right-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + 3rem);
    align-self: start;
    max-height: calc(100vh - var(--nav-height) - 6rem);
    overflow-y: auto;
  }

  .toc {
    padding: 0;
  }

  .toc-label {
    display: block;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin: 0;
  }

  .toc-link {
    display: block;
    padding: 0.28rem 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .toc-link:hover {
    color: var(--color-text);
  }

  .toc-link.active {
    color: var(--color-text);
    font-weight: 600;
  }

  .toc-item.sub .toc-link {
    padding-left: 0.85rem;
    font-size: 0.77rem;
  }

  .toc-item.sub-sub .toc-link {
    padding-left: 1.6rem;
    font-size: 0.74rem;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .article-container {
      grid-template-columns: minmax(0, 1fr);
      margin: 2.5rem 0;
    }

    .right-sidebar {
      display: none;
    }

    .post-title {
      font-size: 1.85rem;
    }
  }
</style>
